# Campus AI frontend configuration
# Copy this file to `.env` (or `.env.local`) and adjust the values.

# Base URL of the Flask backend (no trailing slash).
# Leave empty to run the frontend with built-in demonstration (mock) responses.
VITE_API_BASE_URL=

# Optional: force mock responses even when VITE_API_BASE_URL is set ("true" / "false").
# VITE_USE_MOCK_API=false
